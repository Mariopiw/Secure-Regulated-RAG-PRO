POSTGRES_DB=rag
POSTGRES_ADMIN_USER=rag_admin
POSTGRES_ADMIN_PASSWORD=change-admin-db-password
RAG_APP_PASSWORD=change-runtime-db-password

DATABASE_URL=postgresql+asyncpg://rag_app:change-runtime-db-password@db:5432/rag
MIGRATION_DATABASE_URL=postgresql+asyncpg://rag_admin:change-admin-db-password@db:5432/rag

JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen3.5:4b
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIM=768

TOP_K_VECTOR=20
TOP_K_LEXICAL=20
TOP_K_FINAL=6
RRF_K=60
MIN_VECTOR_SIMILARITY=0.28
MAX_FILE_BYTES=15728640
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=180

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-now
BOOTSTRAP_TENANT_SLUG=demo-bank

OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
